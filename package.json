{
  "type": "module",
  "name": "docentedoc-ai",
  "version": "1.0.0",
  "description": "DocenteDoc AI - An intelligent teaching assistant for Italian educators.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest --run",
    "test:visual:md3": "playwright test __tests__/visual-regression/md3-*.spec.ts",
    "test:visual:md3:components": "playwright test __tests__/visual-regression/md3-components.spec.ts",
    "test:visual:md3:screens": "playwright test __tests__/visual-regression/md3-screens.spec.ts",
    "test:visual:md3:update": "playwright test __tests__/visual-regression/md3-*.spec.ts --update-snapshots",
    "test:visual:md3:debug": "playwright test __tests__/visual-regression/md3-components.spec.ts --debug",
    "analyze:visual:md3": "node scripts/analyze-md3-visual-diffs.cjs",
    "report:visual:md3": "node scripts/generate-md3-visual-report.cjs",
    "lint:md3": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint-md3.config.js",
    "test:presentation": "playwright test __tests__/visual-regression/presentation-screenshots.spec.ts",
    "presentation:capture": "node scripts/capture-screenshots.js",
    "presentation:video": "node scripts/generate-presentation-video.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:heal": "node scripts/lint-heal.js",
    "lint:metrics": "node scripts/lint-metrics.js",
    "md3:audit": "npm run lint",
    "md3:check": "npm run lint",
    "md3:scan": "npm run lint",
    "md3:scan:strict": "npm run lint -- --max-warnings 0",
    "md3:theme:audit": "npm run lint",
    "md3:zindex:audit": "npm run lint",
    "md3:motion:audit": "npm run lint",
    "md3:component:audit": "npm run lint",
    "md3:audit:all": "npm run lint && npx tsc -b --noEmit",
    "md3:validate": "npm run lint && npm run build",
    "validate:m3": "npm run lint",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pretest:snapshots": "node generateStorySnapshots.mjs",
    "test:snapshots": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --project chromium-stable",
    "test:e2e:spa": "playwright test --project spa-navigation",
    "test:e2e:ci": "playwright test --project chromium-stable --shard=1/2",
    "lighthouse": "node scripts/lighthouse-audit.js",
    "lighthouse:perf": "node scripts/lighthouse-audit.js --categories performance",
    "lighthouse:a11y": "node scripts/lighthouse-audit.js --categories accessibility",
    "lighthouse:ci": "node scripts/lighthouse-audit.js --categories performance,accessibility,best-practices,seo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@google/genai": "^1.34.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@sentry/react": "^8.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/papaparse": "^5.5.2",
    "chrome-launcher": "^1.2.1",
    "dexie": "^4.3.0",
    "docx": "^9.5.1",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "glob": "^13.0.6",
    "jsdom": "^27.4.0",
    "jspdf": "^4.2.1",
    "lighthouse": "^12.8.2",
    "mammoth": "^1.11.0",
    "mitt": "^3.0.1",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.530",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.3.1",
    "recharts": "^3.7.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "@axe-core/playwright": "^4.11.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@eslint/js": "^9.39.2",
    "@mdx-js/mdx": "^2.3.0",
    "@mdx-js/react": "^2.3.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-interactions": "^8.6.15",
    "@storybook/addon-links": "^8.6.15",
    "@storybook/addon-onboarding": "^8.6.15",
    "@storybook/manager-api": "^8.6.15",
    "@storybook/mdx2-csf": "^1.1.0",
    "@storybook/react": "^8.6.15",
    "@storybook/react-dom-shim": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@storybook/theming": "^8.6.15",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vercel/node": "^4.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "axe-core": "^4.11.0",
    "commitlint": "^20.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^0.8.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "playwright": "^1.57.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^8.6.15",
    "stylelint": "^17.4.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^6.0.0",
    "vite-plugin-compression2": "^2.5.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^0.19.8",
    "vitest": "^4.0.16"
  },
  "author": "",
  "license": "ISC",
  "overrides": {
    "react-is": "^18.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "eslint"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
